// Shared build settings. XcodeGen merges this into every target via the
// `configFiles` key in project.yml. Values can be overridden on the
// command line with `RESONANCE_BUNDLE_ID=... xcodebuild ...`.
//
// Edit RESONANCE_DEVELOPMENT_TEAM below (or export it as an env var) to
// match the 10-character Team ID shown under your Apple Developer
// account membership. A personal Apple ID works for the `development`
// export method that powers AltStore / Sideloadly.

RESONANCE_BUNDLE_ID = com.example.resonance
RESONANCE_MARKETING_VERSION = 0.1.0
RESONANCE_BUILD_NUMBER = 1
RESONANCE_DEVELOPMENT_TEAM =
RESONANCE_CODE_SIGN_IDENTITY = Apple Development

// Allow ad-hoc / personal-team signing without forcing a paid
// provisioning profile. xcodebuild skips the developer-services
// roundtrip when these are left empty.
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = $(RESONANCE_CODE_SIGN_IDENTITY)
DEVELOPMENT_TEAM = $(RESONANCE_DEVELOPMENT_TEAM)
PRODUCT_BUNDLE_IDENTIFIER = $(RESONANCE_BUNDLE_ID)
MARKETING_VERSION = $(RESONANCE_MARKETING_VERSION)
CURRENT_PROJECT_VERSION = $(RESONANCE_BUILD_NUMBER)

// Sideload-specific tweaks: bitcode has been obsolete since Xcode 14,
// and we explicitly opt out of Swift's runtime-stripping optimisation
// (introduced in Xcode 16) so AltStore's re-sign step does not trip
// over a stripped `LC_MAIN`.
SWIFT_OPTIMIZATION_LEVEL = -Onone
ENABLE_BITCODE = NO
STRIP_INSTALLED_PRODUCT = NO
SEPARATE_STRIP = NO
DEAD_CODE_STRIPPING = YES
